{
  "name": "desktop-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../../../docs/api/openapi.json -o src/api/schema.d.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --test src/state/timeline.test.ts src/state/controlBridge.test.ts src/api/events.test.ts src/lib/providerView.test.ts src/lib/route.test.ts src/lib/notifyRules.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "i18next": "^24.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "vite": "^6.2.0"
  }
}
