{
  "name": "desktop-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../../../docs/api/openapi.json -o src/api/schema.d.ts",
    "check:i18n": "node scripts/sort-locales.mjs --check && node scripts/check-i18n.mjs",
    "sort:i18n": "node scripts/sort-locales.mjs",
    "test": "node --test \"src/**/*.test.ts\" && pnpm test:contrast",
    "check:themes": "node ../../../packages/ui/scripts/check-themes.mjs",
    "check:layout": "node ../../../packages/ui/scripts/check-layout.mjs",
    "check:layout:browser": "node scripts/check-layout-browser.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:contrast": "vitest run tests/wallpaper.contrast.spec.ts",
    "check:chat-ui": "node scripts/check-chat-ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "i18next": "^24.2.2",
    "lucide-react": "^1.70.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "simple-icons": "^16.36.0",
    "ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.1",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.65.1",
    "vite": "^6.2.0",
    "vitest": "^5.1.1"
  }
}
