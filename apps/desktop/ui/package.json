{
  "name": "desktop-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../../../docs/api/openapi.json -o src/api/schema.d.ts",
    "build:guide-index": "node scripts/build-guide-index.mjs",
    "docs:screenshots": "node scripts/docs-screenshots/capture.mjs",
    "check:guide-index": "node scripts/build-guide-index.mjs --check",
    "check:i18n": "node scripts/sort-locales.mjs --check && node scripts/check-i18n.mjs",
    "sort:i18n": "node scripts/sort-locales.mjs",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\" && pnpm test:contrast",
    "check:themes": "node ../../../packages/ui/scripts/check-themes.mjs",
    "check:layout": "node ../../../packages/ui/scripts/check-layout.mjs",
    "check:layout:browser": "node scripts/check-layout-browser.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "check:visual:update": "node scripts/check-visual.mjs --update --no-contrast",
    "check:mock-flows": "node scripts/check-mock-flows.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:contrast": "vitest run tests/wallpaper.contrast.spec.ts",
    "check:chat-ui": "node scripts/check-chat-ui.mjs",
    "check:attachments": "node scripts/check-attachments.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "i18next": "27.2.7",
    "lucide-react": "^1.75.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "18.0.3",
    "simple-icons": "^16.38.0",
    "ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.65.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
