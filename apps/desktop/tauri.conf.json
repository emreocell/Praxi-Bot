{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Praxi-Bot",
  "mainBinaryName": "bot-desktop",
  "version": "0.1.0",
  "identifier": "com.praxibot.desktop",
  "build": {
    "frontendDist": "./ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter desktop-ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Praxi-Bot",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
