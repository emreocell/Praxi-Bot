{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Praxi-Bot",
  "mainBinaryName": "bot-desktop",
  "version": "0.1.0",
  "identifier": "com.praxibot.desktop",
  "build": {
    "frontendDist": "./ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter desktop-ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Praxi-Bot",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default", "main-window"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Praxi-Bot",
    "category": "Productivity",
    "shortDescription": "Local-first personal computer-use assistant",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bot"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Praxi-Bot",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
