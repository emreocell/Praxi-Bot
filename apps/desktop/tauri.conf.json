{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Praxi-Bot",
  "mainBinaryName": "bot-desktop",
  "version": "0.1.0",
  "identifier": "com.praxibot.desktop",
  "build": {
    "frontendDist": "./ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter desktop-ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Praxi-Bot",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "main-window",
        "app-commands-main",
        "app-commands-widget",
        "app-commands-overlay",
        "quick-ask",
        "chat-popout",
        "live-popout"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://localhost:1420; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["praxi"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/emreocell/Praxi-Bot/releases/latest/download/latest.json"
      ],
      "praxiPreviewEndpoint": "https://raw.githubusercontent.com/emreocell/Praxi-Bot/update-feed/preview.json",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Praxi-Bot",
    "category": "Productivity",
    "shortDescription": "Local-first personal computer-use assistant",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bot"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Praxi-Bot",
        "languages": [
          "English",
          "Turkish",
          "German"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
