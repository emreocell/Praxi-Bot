# Copy to .env (gitignored) and replace placeholder values before starting.
# Never commit .env or paste its contents.

# Required: passphrase for the encrypted file secret store (/var/lib/praxi/secrets.enc).
# Generate one with: openssl rand -hex 32
BOT_SECRETS_PASSPHRASE=replace-with-a-random-32-byte-hex-passphrase

# Optional: daemon loopback port inside the container (default: 47821).
BOT_PORT=47821

# Optional: provider API keys passed via environment (or configure interactively
# after startup with `docker exec -it praxi-host bot setup`).
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
