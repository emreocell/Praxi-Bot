{
  "name": "obsidian",
  "mode": "dark",
  "tokens": {
    "--color-background": "#111217",
    "--color-surface": "#1A1A1B",
    "--color-surface-elevated": "#222223",
    "--color-surface-active": "#2C2C2D",
    "--color-text": "#F2F2F5",
    "--color-text-secondary": "#CBCBCB",
    "--color-text-muted": "#A3A3A3",
    "--color-accent": "#B6B8FA",
    "--color-accent-contrast": "#171824",
    "--color-accent-text": "#C4C5FF",
    "--color-border": "#ffffff12",
    "--color-border-strong": "#7E808F",
    "--color-text-inverse": "#171824",
    "--color-accent-hover": "color-mix(in srgb, #B6B8FA 88%, #ffffff)",
    "--color-accent-subtle": "color-mix(in srgb, #B6B8FA 12%, #18191F)",
    "--color-surface-overlay": "color-mix(in srgb, #18191F 88%, transparent)",
    "--color-backdrop-dim": "#100E0C",
    "--color-modal-backdrop": "#00000099",
    "--color-success": "#92CEAC",
    "--color-warning": "#E8BE7C",
    "--color-danger": "#F4A3A3",
    "--color-danger-contrast": "#351111",
    "--color-danger-subtle": "color-mix(in srgb, var(--color-danger) 10%, #18191F)",
    "--color-warning-subtle": "color-mix(in srgb, var(--color-warning) 10%, #18191F)",
    "--color-focus": "#A5A5A5",
    "--color-scrollbar": "#484848",
    "--color-selection": "#2A2B33",
    "--color-selection-text": "#F2F2F5",
    "--color-code-bg": "#111217",
    "--color-code-text": "#F2F2F5",
    "--color-code-keyword": "#C4C5FF",
    "--color-code-string": "#92CEAC",
    "--color-code-number": "#E8BE7C",
    "--color-code-comment": "#999AA8",
    "--color-overlay-target-bg": "color-mix(in srgb, #B6B8FA 16%, transparent)",
    "--color-overlay-ripple": "color-mix(in srgb, #B6B8FA 48%, transparent)",
    "--color-overlay-human-bg": "var(--color-warning-subtle)",
    "--color-accent-deep": "#C4C5FF",
    "--shadow-sm": "0 1px 2px #00000030",
    "--shadow-card": "0 4px 16px #00000018",
    "--shadow-overlay": "0 32px 100px #00000080, 0 0 0 1px #ffffff04",
    "--shadow-focus": "0 0 0 2px var(--color-background), 0 0 0 4px var(--color-focus)",
    "--shadow-target": "0 0 0 4px var(--color-accent-subtle)",
    "--shadow-human-banner": "0 0 0 3px var(--color-warning-subtle)",
    "--color-primary": "#F4F4F4",
    "--color-primary-contrast": "#171717",
    "--color-logo-tile": "#F5F5F3",
    "--color-creature-eyes": "#172125"
  },
  "background": {
    "url": "",
    "blur": "0px",
    "dim": "0"
  }
}
