  {
    "id": "github",
    "name": "GitHub (access token)",
    "description": "Advanced: connects with a personal access token you paste. For a one-click sign-in use the GitHub app in the main Apps list instead. Prefer a fine-grained token with only the permissions you use.",
    "category": "accounts",
    "homepage": "https://github.com/github/github-mcp-server",
    "icon": "github",
    "install": {
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "secret_headers": {
        "Authorization": "Bearer {secret:mcp/github-token}"
      },
      "required_secrets": [
        {
          "name": "mcp/github-token",
          "label": "GitHub fine-grained personal access token (least privilege)",
          "help_url": "https://github.com/settings/personal-access-tokens/new"
        }
      ]
    }
  },
