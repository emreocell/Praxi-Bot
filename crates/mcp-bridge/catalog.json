  {
    "id": "google-gmail",
    "name": "Gmail (your own Google client)",
    "description": "Search and read your mail, read-only. Sign in with a Google client you create once in your own Google Cloud project; Praxi has no shared one. Mail stays between Google and this computer.",
    "category": "accounts",
    "homepage": "https://developers.google.com/workspace/guides/configure-mcp-servers",
    "icon": "gmail",
    "install": {
      "transport": "http",
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "required_secrets": [],
      "oauth_client": {
        "issuer": "https://accounts.google.com",
        "scopes": [
          "https://www.googleapis.com/auth/gmail.readonly"
        ],
        "offline_access": true,
        "setup": "google"
      },
      "tool_allow": [
        "search_threads",
        "get_thread",
        "get_message",
        "list_labels",
        "list_drafts",
        "get_draft"
      ],
      "test": {
        "tool": "search_threads",
        "arguments": {
          "query": "in:inbox",
          "pageSize": 3
        }
      }
    }
  },
  {
    "id": "google-drive",
    "name": "Google Drive (your own Google client)",
    "description": "Search and read your Drive files, read-only. Sign in with a Google client you create once in your own Google Cloud project; Praxi has no shared one.",
    "category": "accounts",
    "homepage": "https://developers.google.com/workspace/guides/configure-mcp-servers",
    "icon": "googledrive",
    "install": {
      "transport": "http",
      "url": "https://drivemcp.googleapis.com/mcp/v1",
      "required_secrets": [],
      "oauth_client": {
        "issuer": "https://accounts.google.com",
        "scopes": [
          "https://www.googleapis.com/auth/drive.readonly"
        ],
        "offline_access": true,
        "setup": "google"
      },
      "tool_allow": [
        "search_files",
        "list_recent_files",
        "get_file_metadata",
        "get_file_permissions",
        "read_file_content",
        "download_file_content"
      ],
      "test": {
        "tool": "list_recent_files",
        "arguments": {
          "pageSize": 3,
          "excludeContentSnippets": true
        }
      }
    }
  },
  {
    "id": "google-calendar",
    "name": "Google Calendar (your own Google client)",
    "description": "See your calendars and events, read-only. Sign in with a Google client you create once in your own Google Cloud project; Praxi has no shared one.",
    "category": "accounts",
    "homepage": "https://developers.google.com/workspace/guides/configure-mcp-servers",
    "icon": "googlecalendar",
    "install": {
      "transport": "http",
      "url": "https://calendarmcp.googleapis.com/mcp/v1",
      "required_secrets": [],
      "oauth_client": {
        "issuer": "https://accounts.google.com",
        "scopes": [
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy"
        ],
        "offline_access": true,
        "setup": "google"
      },
      "tool_allow": [
        "list_calendars",
        "list_events",
        "get_event",
        "search_events",
        "suggest_time"
      ],
      "test": {
        "tool": "list_calendars",
        "arguments": {
          "pageSize": 3
        }
      }
    }
  },
  {
    "id": "postgres",
    "name": "PostgreSQL",
    "description": "Inspect schemas and run queries (restricted, read-only mode) on a Postgres database.",
    "category": "accounts",
    "homepage": "https://github.com/crystaldba/postgres-mcp",
    "icon": "postgresql",
    "install": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "postgres-mcp==0.3.0",
        "--access-mode=restricted"
      ],
      "secret_env": {
        "DATABASE_URI": "mcp/postgres-token"
      },
      "required_secrets": [
        {
          "name": "mcp/postgres-token",
          "label": "PostgreSQL connection URI (postgresql://user:pass@host:5432/db)"
        }
      ]
    }
  },
