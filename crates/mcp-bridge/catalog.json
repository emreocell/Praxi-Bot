[
  {
    "id": "filesystem",
    "name": "Filesystem",
    "description": "Read, write and search files inside a folder you choose (edit the last argument).",
    "category": "fs",
    "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
    "icon": null,
    "install": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "required_secrets": []
    }
  },
  {
    "id": "github",
    "name": "GitHub",
    "description": "Repositories, issues, pull requests and code search.",
    "category": "accounts",
    "homepage": "https://github.com/github/github-mcp-server",
    "icon": "github",
    "install": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "secret_env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "mcp/github-token"
      },
      "required_secrets": [
        {
          "name": "mcp/github-token",
          "label": "GitHub personal access token",
          "help_url": "https://github.com/settings/tokens"
        }
      ]
    }
  },
