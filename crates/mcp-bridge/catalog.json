  {
    "id": "postgres",
    "name": "PostgreSQL",
    "description": "Inspect schemas and run queries (restricted, read-only mode) on a Postgres database.",
    "category": "accounts",
    "homepage": "https://github.com/crystaldba/postgres-mcp",
    "icon": "postgresql",
    "install": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "postgres-mcp",
        "--access-mode=restricted"
      ],
      "secret_env": {
        "DATABASE_URI": "mcp/postgres-token"
      },
      "required_secrets": [
        {
          "name": "mcp/postgres-token",
          "label": "PostgreSQL connection URI (postgresql://user:pass@host:5432/db)"
        }
      ]
    }
  },
  {
    "id": "sqlite",
    "name": "SQLite",
    "description": "Query and analyse a local SQLite database file (edit the path argument).",
    "category": "fs",
    "homepage": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/sqlite",
    "icon": "sqlite",
    "install": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "./data.db"
      ],
      "required_secrets": []
    }
  },
