  {
    "id": "slack",
    "name": "Slack",
    "description": "Read channels and post messages as a Slack bot.",
    "category": "messaging",
    "homepage": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/slack",
    "icon": "slack",
