      "required_secrets": [
        {
          "name": "mcp/slack-bot-token",
          "label": "Slack bot token (xoxb-...)",
          "help_url": "https://api.slack.com/apps"
        },
        {
          "name": "mcp/slack-team-id",
          "label": "Slack workspace (team) id, e.g. T01234567",
          "help_url": "https://api.slack.com/apps"
        }
      ]
    }
