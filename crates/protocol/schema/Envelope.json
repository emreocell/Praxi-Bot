{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope",
  "description": "A versioned, sequenced wrapper around a single [`Event`].\n\nClients use `seq` to detect gaps and `v` to handle future schema changes.",
  "type": "object",
  "required": [
    "event",
    "seq",
    "ts_ms",
    "v"
  ],
  "properties": {
    "event": {
      "description": "The event payload.",
      "allOf": [
        {
          "$ref": "#/definitions/Event"
        }
      ]
    },
    "parent_run_id": {
      "description": "Set on every event emitted by a subagent (child) run: the run that spawned it.  Absent on top-level runs.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "seq": {
      "description": "Monotonically increasing sequence number within a run.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "ts_ms": {
      "description": "Unix epoch milliseconds when the event was emitted (from [`std::time::SystemTime`]).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "v": {
      "description": "Schema version.  Currently always `1`.",
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    }
  },
  "definitions": {
    "ControlRect": {
      "description": "A rectangle in global physical screen pixels.",
      "type": "object",
      "required": [
        "height",
        "width",
        "x",
        "y"
      ],
      "properties": {
        "height": {
          "type": "number",
          "format": "double"
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "Event": {
      "description": "All events that can appear in the client event stream.",
      "oneOf": [
        {
          "description": "A run has started.",
          "type": "object",
          "required": [
            "bot_id",
            "chat_id",
            "run_id",
            "type"
          ],
          "properties": {
            "bot_id": {
              "type": "string",
              "format": "uuid"
            },
            "chat_id": {
              "type": "string",
              "format": "uuid"
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "schedule_id": {
              "description": "The schedule that started this run (scheduled runs only; additive).",
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "run_started"
              ]
            }
          }
        },
        {
          "description": "A run has completed (successfully or not).",
          "type": "object",
          "required": [
            "run_id",
            "type"
          ],
          "properties": {
            "error": {
              "description": "`None` on success, an error message on failure.",
              "type": [
                "string",
                "null"
              ]
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "run_finished"
              ]
            }
          }
        },
        {
          "description": "A partial text chunk from the assistant.",
          "type": "object",
          "required": [
            "run_id",
            "text",
            "type"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "text": {
              "description": "Incremental text to append to the current assistant message.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "message_delta"
              ]
            }
          }
        },
        {
          "description": "The agent has requested a tool call; waiting for approval or execution.",
          "type": "object",
          "required": [
            "call_id",
            "input",
            "run_id",
            "tool_name",
            "type"
          ],
          "properties": {
            "call_id": {
              "type": "string",
              "format": "uuid"
            },
            "input": true,
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "tool_name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "tool_call_requested"
              ]
            }
          }
        },
        {
          "description": "A human-approval gate is waiting for the user to respond.",
          "type": "object",
          "required": [
            "call_id",
            "input",
            "run_id",
            "summary",
            "tool_name",
            "type"
          ],
          "properties": {
            "call_id": {
              "type": "string",
              "format": "uuid"
            },
            "details": {
              "description": "Structured facts the tool supplies for the approval card (for example a schedule's prompt and next firing times), when it has any."
            },
            "input": true,
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "summary": {
              "description": "A human-readable summary of what will happen.",
              "type": "string"
            },
            "tool_name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "approval_needed"
              ]
            }
          }
        },
        {
          "description": "The user approved a pending tool call.",
          "type": "object",
          "required": [
            "approved_by",
            "call_id",
            "run_id",
            "type"
          ],
          "properties": {
            "approved_by": {
              "type": "string",
              "format": "uuid"
            },
            "call_id": {
              "type": "string",
              "format": "uuid"
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "tool_call_approved"
              ]
            }
          }
        },
        {
          "description": "The user denied a pending tool call.",
          "type": "object",
          "required": [
            "call_id",
            "denied_by",
            "run_id",
            "type"
          ],
          "properties": {
            "call_id": {
              "type": "string",
              "format": "uuid"
            },
            "denied_by": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "tool_call_denied"
              ]
            }
          }
        },
        {
          "description": "A tool call has completed; output is available.",
          "type": "object",
          "required": [
            "call_id",
            "run_id",
            "type"
          ],
          "properties": {
            "call_id": {
              "type": "string",
              "format": "uuid"
            },
            "duration_ms": {
              "description": "Time the tool itself ran, in milliseconds (excludes approval waits).",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "error": {
              "description": "`None` on success, an error message on failure.",
              "type": [
                "string",
                "null"
              ]
            },
            "output_preview": {
              "description": "Truncated (at most 2 KB), redacted start of the tool's output.",
              "type": [
                "string",
                "null"
              ]
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "tool_call_completed"
              ]
            }
          }
        },
        {
          "description": "The model replaced its todo list (plan tool); carries the full new list.",
          "type": "object",
          "required": [
            "items",
            "run_id",
            "type"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TodoItem"
              }
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "todo_updated"
              ]
            }
          }
        },
        {
          "description": "The model asked the user a question (`ask_user`); the run waits until the question is answered.",
          "type": "object",
          "required": [
            "call_id",
            "options",
            "question",
            "run_id",
            "type"
          ],
          "properties": {
            "call_id": {
              "description": "Id to answer with.",
              "type": "string",
              "format": "uuid"
            },
            "options": {
              "description": "Suggested answers (may be empty).",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "question": {
              "type": "string"
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "question_asked"
              ]
            }
          }
        },
        {
          "description": "The loop switched to a fallback model after the previous one kept failing.",
          "type": "object",
          "required": [
            "from",
            "reason",
            "run_id",
            "to",
            "type"
          ],
          "properties": {
            "from": {
              "description": "Model that failed.",
              "type": "string"
            },
            "reason": {
              "description": "The error that caused the switch.",
              "type": "string"
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "to": {
              "description": "Model tried next.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "model_fallback"
              ]
            }
          }
        },
        {
          "description": "The K0-K3 ladder decided how a turn starts (ADR-0005), before the main model (K4) runs.  Emitted once per top-level turn of a bot whose router is enabled.",
          "type": "object",
          "required": [
            "confidence",
            "latency_ms",
            "level",
            "reason",
            "route",
            "run_id",
            "type"
          ],
          "properties": {
            "confidence": {
              "description": "Confidence in `0..=1`.",
              "type": "number",
              "format": "double"
            },
            "latency_ms": {
              "description": "Wall time of the whole decision.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "level": {
              "description": "Level that decided: `K0` (rules / commands), `K1` (intent cache), `K2` (BM25 + embeddings), `K3` (classifier) or `K4` (nothing cheaper applied).",
              "type": "string"
            },
            "reason": {
              "description": "Why (for the \"why did it do that\" panel).",
              "type": "string"
            },
            "route": {
              "description": "The route, tagged by `kind`: `command` (`name`, `args`), `workflow` (`name`, `params`, `confidence`), `tool_hint` (`tools`), `skill_hint` (`skills`) or `agent`."
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "route_decided"
              ]
            }
          }
        },
        {
          "description": "A recorded workflow step is about to run (deterministic replay, no model).",
          "type": "object",
          "required": [
            "kind",
            "step_index",
            "type",
            "workflow"
          ],
          "properties": {
            "kind": {
              "description": "Step kind, e.g. `desktop_action`.",
              "type": "string"
            },
            "run_id": {
              "description": "Run that started the replay, if it was started from a run.",
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "step_index": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "workflow_step_started"
              ]
            },
            "workflow": {
              "type": "string"
            }
          }
        },
        {
          "description": "A workflow step finished successfully.",
          "type": "object",
          "required": [
            "step_index",
            "type",
            "workflow"
          ],
          "properties": {
            "resolved_via": {
              "description": "Locator strategy that found the target, when the step had one.",
              "type": [
                "string",
                "null"
              ]
            },
            "run_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "step_index": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "workflow_step_completed"
              ]
            },
            "workflow": {
              "type": "string"
            }
          }
        },
        {
          "description": "A workflow step could not run (drift, ambiguity, failure or denial); the replay stopped and control goes back to the agent.",
          "type": "object",
          "required": [
            "reason",
            "step_index",
            "type",
            "workflow"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "run_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "step_index": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "workflow_drift"
              ]
            },
            "workflow": {
              "type": "string"
            }
          }
        },
        {
          "description": "A desktop action is about to run: the daemon asks the desktop app (if one is connected) to show the on-screen overlay first.  The app answers with `POST /v1/control/{request_id}`; without an answer the daemon decides on its own after a timeout.",
          "type": "object",
          "required": [
            "action",
            "bot_id",
            "label",
            "request_id",
            "run_id",
            "type"
          ],
          "properties": {
            "action": {
              "description": "`click`, `type`, `key`, `scroll`, `drag`, `set_value`, `launch`, ...",
              "type": "string"
            },
            "bot_id": {
              "type": "string",
              "format": "uuid"
            },
            "label": {
              "description": "Short description of the target, e.g. `Save button`.",
              "type": "string"
            },
            "rect": {
              "description": "Target of the action (global physical screen pixels), when known.",
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlRect"
                },
                {
                  "type": "null"
                }
              ]
            },
            "request_id": {
              "description": "Id to answer with.",
              "type": "string",
              "format": "uuid"
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "control_requested"
              ]
            }
          }
        },
        {
          "description": "The agent spawned a subagent (a child run of the same bot).  Emitted on the parent run's stream; the child's own events carry `parent_run_id` in their envelope.",
          "type": "object",
          "required": [
            "parent_run_id",
            "run_id",
            "task",
            "type"
          ],
          "properties": {
            "call_id": {
              "description": "The parent's `spawn_subagent` tool call that created the child.",
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "parent_run_id": {
              "type": "string",
              "format": "uuid"
            },
            "run_id": {
              "description": "The child run.",
              "type": "string",
              "format": "uuid"
            },
            "task": {
              "description": "What the child was asked to do.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "subagent_started"
              ]
            }
          }
        },
        {
          "description": "A subagent run ended.",
          "type": "object",
          "required": [
            "parent_run_id",
            "run_id",
            "state",
            "summary",
            "type"
          ],
          "properties": {
            "call_id": {
              "description": "The parent's `spawn_subagent` tool call that created the child.",
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "parent_run_id": {
              "type": "string",
              "format": "uuid"
            },
            "run_id": {
              "description": "The child run.",
              "type": "string",
              "format": "uuid"
            },
            "state": {
              "description": "Final run state: `succeeded`, `failed`, `cancelled` or `paused`.",
              "type": "string"
            },
            "summary": {
              "description": "The child's final text (at most 2 KB here; the parent's tool result carries up to 8 KB) or the failure message.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "subagent_finished"
              ]
            }
          }
        },
        {
          "description": "A non-fatal error occurred during the run.",
          "type": "object",
          "required": [
            "message",
            "recoverable",
            "run_id",
            "type"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "recoverable": {
              "type": "boolean"
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "enum": [
                "error"
              ]
            }
          }
        }
      ]
    },
    "TodoItem": {
      "description": "One entry of the model-maintained todo list.",
      "type": "object",
      "required": [
        "status",
        "text"
      ],
      "properties": {
        "status": {
          "$ref": "#/definitions/TodoStatus"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "TodoStatus": {
      "description": "Progress of one todo item.",
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "done"
      ]
    }
  }
}
