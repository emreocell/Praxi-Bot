{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "description": "All events that can appear in the client event stream.",
  "oneOf": [
    {
      "description": "A run has started.",
      "type": "object",
      "required": [
        "bot_id",
        "chat_id",
        "run_id",
        "type"
      ],
      "properties": {
        "bot_id": {
          "type": "string",
          "format": "uuid"
        },
        "chat_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "run_started"
          ]
        }
      }
    },
    {
      "description": "A run has completed (successfully or not).",
      "type": "object",
      "required": [
        "run_id",
        "type"
      ],
      "properties": {
        "error": {
          "description": "`None` on success, an error message on failure.",
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "run_finished"
          ]
        }
      }
    },
    {
      "description": "A partial text chunk from the assistant.",
      "type": "object",
      "required": [
        "run_id",
        "text",
        "type"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "description": "Incremental text to append to the current assistant message.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "message_delta"
          ]
        }
      }
    },
    {
      "description": "The agent has requested a tool call; waiting for approval or execution.",
      "type": "object",
      "required": [
        "call_id",
        "input",
        "run_id",
        "tool_name",
        "type"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "format": "uuid"
        },
        "input": true,
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "tool_name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "tool_call_requested"
          ]
        }
      }
    },
    {
      "description": "A human-approval gate is waiting for the user to respond.",
      "type": "object",
      "required": [
        "call_id",
        "input",
        "run_id",
        "summary",
        "tool_name",
        "type"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "format": "uuid"
        },
        "input": true,
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "summary": {
          "description": "A human-readable summary of what will happen.",
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "approval_needed"
          ]
        }
      }
    },
    {
      "description": "The user approved a pending tool call.",
      "type": "object",
      "required": [
        "approved_by",
        "call_id",
        "run_id",
        "type"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "format": "uuid"
        },
        "call_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "tool_call_approved"
          ]
        }
      }
    },
    {
      "description": "The user denied a pending tool call.",
      "type": "object",
      "required": [
        "call_id",
        "denied_by",
        "run_id",
        "type"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "format": "uuid"
        },
        "denied_by": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "tool_call_denied"
          ]
        }
      }
    },
    {
      "description": "A tool call has completed; output is available.",
      "type": "object",
      "required": [
        "call_id",
        "run_id",
        "type"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "format": "uuid"
        },
        "error": {
          "description": "`None` on success, an error message on failure.",
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "tool_call_completed"
          ]
        }
      }
    },
    {
      "description": "The model replaced its todo list (plan tool); carries the full new list.",
      "type": "object",
      "required": [
        "items",
        "run_id",
        "type"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TodoItem"
          }
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "todo_updated"
          ]
        }
      }
    },
    {
      "description": "The model asked the user a question (`ask_user`); the run waits until the question is answered.",
      "type": "object",
      "required": [
        "call_id",
        "options",
        "question",
        "run_id",
        "type"
      ],
      "properties": {
        "call_id": {
          "description": "Id to answer with.",
          "type": "string",
          "format": "uuid"
        },
        "options": {
          "description": "Suggested answers (may be empty).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "question": {
          "type": "string"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "question_asked"
          ]
        }
      }
    },
    {
      "description": "The loop switched to a fallback model after the previous one kept failing.",
      "type": "object",
      "required": [
        "from",
        "reason",
        "run_id",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "description": "Model that failed.",
          "type": "string"
        },
        "reason": {
          "description": "The error that caused the switch.",
          "type": "string"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "to": {
          "description": "Model tried next.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "model_fallback"
          ]
        }
      }
    },
    {
      "description": "A recorded workflow step is about to run (deterministic replay, no model).",
      "type": "object",
      "required": [
        "kind",
        "step_index",
        "type",
        "workflow"
      ],
      "properties": {
        "kind": {
          "description": "Step kind, e.g. `desktop_action`.",
          "type": "string"
        },
        "run_id": {
          "description": "Run that started the replay, if it was started from a run.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "step_index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "workflow_step_started"
          ]
        },
        "workflow": {
          "type": "string"
        }
      }
    },
    {
      "description": "A workflow step finished successfully.",
      "type": "object",
      "required": [
        "step_index",
        "type",
        "workflow"
      ],
      "properties": {
        "resolved_via": {
          "description": "Locator strategy that found the target, when the step had one.",
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "step_index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "workflow_step_completed"
          ]
        },
        "workflow": {
          "type": "string"
        }
      }
    },
    {
      "description": "A workflow step could not run (drift, ambiguity, failure or denial); the replay stopped and control goes back to the agent.",
      "type": "object",
      "required": [
        "reason",
        "step_index",
        "type",
        "workflow"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "step_index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "workflow_drift"
          ]
        },
        "workflow": {
          "type": "string"
        }
      }
    },
    {
      "description": "A non-fatal error occurred during the run.",
      "type": "object",
      "required": [
        "message",
        "recoverable",
        "run_id",
        "type"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "recoverable": {
          "type": "boolean"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "error"
          ]
        }
      }
    }
  ],
  "definitions": {
    "TodoItem": {
      "description": "One entry of the model-maintained todo list.",
      "type": "object",
      "required": [
        "status",
        "text"
      ],
      "properties": {
        "status": {
          "$ref": "#/definitions/TodoStatus"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "TodoStatus": {
      "description": "Progress of one todo item.",
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "done"
      ]
    }
  }
}
