{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Praxi skill index, version 1",
  "type": "object",
  "required": ["version", "skills"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "homepage": { "$ref": "#/$defs/https" },
    "skills": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "https": { "type": "string", "pattern": "^https://\\S+$", "maxLength": 200 },
    "entry": {
      "type": "object",
      "required": ["name", "git", "commit"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 64
        },
        "description": { "type": "string", "maxLength": 200 },
        "git": { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]://\\S+$" },
        "commit": { "type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
        "subdir": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" }
        },
        "author": { "type": "string", "minLength": 1, "maxLength": 100 },
        "license": { "type": "string", "minLength": 1, "maxLength": 64 },
        "homepage": { "$ref": "#/$defs/https" },
        "min_praxi_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": true
    }
  }
}
