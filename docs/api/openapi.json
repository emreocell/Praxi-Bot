  "components": {
    "schemas": {
      "AnswerQuestion": {
        "type": "object",
        "description": "`POST /v1/questions/{call_id}`.",
        "required": [
          "answer"
        ],
        "properties": {
          "answer": {
            "type": "string",
            "description": "The user's answer (free text, or one of the offered options)."
          }
        }
      },
      "AnswerResponse": {
        "type": "object",
        "description": "Response of an answered question.",
        "required": [
          "call_id"
        ],
        "properties": {
          "call_id": {
            "type": "string",
            "format": "uuid",
            "description": "Tool call id of the question card."
          }
        }
      },
      "ApprovalDto": {
        "type": "object",
        "description": "A pending or decided tool-call approval.",
        "required": [
          "call_id",
          "run_id",
          "tool_name",
          "summary",
          "requested_at_ms"
        ],
        "properties": {
          "call_id": {
            "type": "string",
            "format": "uuid",
            "description": "Tool call id (what `POST /v1/approvals/{call_id}` takes)."
          },
          "decided_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Decision time."
          },
          "decision": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` while pending, else `approved` / `denied` / `expired`."
          },
          "requested_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Request time."
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "description": "Run awaiting it."
          },
          "summary": {
            "type": "string",
            "description": "Human-readable summary."
          },
          "tool_name": {
            "type": "string",
            "description": "Tool the model wants to call."
          }
        }
      },
      "BotDto": {
        "type": "object",
        "description": "A bot.",
        "required": [
          "id",
          "name",
          "config",
          "created_at_ms"
        ],
        "properties": {
          "config": {
            "description": "Bot profile (ADR-0011) as JSON."
          },
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time."
          },
          "effective_policy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EffectivePolicyDto",
                "description": "The truth about what the bot may do: its stored policy merged with its\npersisted \"always allow\" grants.  Only present in `GET /v1/bots/{id}`."
              }
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Bot id."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          }
        }
      },
      "BotInput": {
        "type": "object",
        "description": "Create (`POST /v1/bots`) or replace (`PUT /v1/bots/{id}`) a bot.  Exactly\none of `config` / `profile_toml` is required.",
        "properties": {
          "config": {
            "description": "Profile as a JSON object."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name (defaults to the profile's `[bot].name`)."
          },
          "profile_toml": {
            "type": [
              "string",
              "null"
            ],
            "description": "Profile as TOML text (the contents of a bot profile file)."
          }
        }
      },
      "BotUsage": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UsageTotals",
            "description": "Its totals."
          },
          {
            "type": "object",
            "required": [
              "bot_id"
            ],
            "properties": {
              "bot_id": {
                "type": "string",
                "format": "uuid",
                "description": "Bot id."
              }
            }
          }
        ],
        "description": "Usage of one bot."
      },
      "CategoryDecisionDto": {
        "type": "object",
        "description": "Effective decision of one permission category.",
        "required": [
          "decision",
          "via_grant"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "description": "`allow`, `ask` or `deny`."
          },
          "via_grant": {
            "type": "boolean",
            "description": "`true` when `allow` holds only because of a category grant."
          }
        }
      },
      "ChatDto": {
        "type": "object",
        "description": "A chat thread.",
        "required": [
          "id",
          "bot_id",
          "title",
          "created_at_ms"
        ],
        "properties": {
          "bot_id": {
            "type": "string",
            "format": "uuid",
            "description": "Bot the chat talks to."
          },
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Chat id."
          },
          "title": {
            "type": "string",
            "description": "Title."
          }
        }
      },
      "CreateChat": {
        "type": "object",
        "description": "`POST /v1/chats`.",
        "required": [
          "bot_id"
        ],
        "properties": {
          "bot_id": {
            "type": "string",
            "format": "uuid",
            "description": "Bot to talk to."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Title (default `New chat`)."
          }
        }
      },
      "DecideApproval": {
        "type": "object",
        "description": "`POST /v1/approvals/{call_id}`.",
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision",
            "description": "Approve or deny."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reason shown to the model on deny."
          },
          "scope": {
            "$ref": "#/components/schemas/Scope",
            "description": "Scope of an approval (ignored for deny)."
          }
        }
      },
      "Decision": {
        "type": "string",
        "description": "Decision verb.",
        "enum": [
          "approve",
          "deny"
        ]
      },
      "DecisionResponse": {
        "type": "object",
        "description": "Response of a decision.",
        "required": [
          "call_id",
          "decision"
        ],
        "properties": {
          "call_id": {
            "type": "string",
            "format": "uuid",
            "description": "Tool call id."
          },
          "decision": {
            "$ref": "#/components/schemas/Decision",
            "description": "The decision taken."
          }
        }
      },
      "DeliveryKind": {
        "type": "string",
        "description": "How a sent message was delivered.",
        "enum": [
          "new_turn",
          "steered",
          "queued"
        ]
      },
      "EffectivePolicyDto": {
        "type": "object",
        "description": "A bot's permission picture (`GET /v1/bots/{id}`).",
        "required": [
          "categories",
          "grants"
        ],
        "properties": {
          "categories": {
            "type": "object",
            "description": "What a human-initiated call of each category resolves to, grants\nincluded (`meta` is always allowed and omitted).",
            "additionalProperties": {
              "$ref": "#/components/schemas/CategoryDecisionDto"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantDto"
            },
            "description": "The persisted \"always allow\" rules.  Tool-level grants only widen that\none tool and are not reflected in `categories`."
          },
          "policy": {
            "description": "The profile's own policy as JSON; `null` = the workspace policy applies."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "JSON body of an error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail",
            "description": "The error."
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "description": "Machine-readable code plus human-readable message.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable `snake_case` code, e.g. `not_found`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable message."
          }
        }
      },
      "GrantDto": {
        "type": "object",
        "description": "A persisted \"always allow\" rule of a bot.",
        "required": [
          "target",
          "granted_at_ms"
        ],
        "properties": {
          "granted_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "When it was granted."
          },
          "target": {
            "$ref": "#/components/schemas/GrantTargetDto",
            "description": "What it covers."
          }
        }
      },
      "GrantTargetDto": {
        "oneOf": [
          {
            "type": "object",
            "description": "One tool, by name.",
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "tool"
                ]
              },
              "name": {
                "type": "string",
                "description": "Tool name."
              }
            }
          },
          {
            "type": "object",
            "description": "Every tool of a permission category.",
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "category"
                ]
              },
              "name": {
                "type": "string",
                "description": "`fs`, `shell`, `desktop`, `browser`, `accounts`, `messaging`,\n`money`, `system`, `remote` or `script`."
              }
            }
          }
        ],
        "description": "What an \"always allow\" grant covers."
      },
      "Health": {
        "type": "object",
        "description": "`GET /v1/health`.",
        "required": [
          "status",
          "version",
          "uptime_secs"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok`."
          },
          "uptime_secs": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds since the daemon started.",
            "minimum": 0
          },
          "version": {
            "type": "string",
            "description": "Daemon crate version."
          }
        }
      },
      "MessageDto": {
        "type": "object",
        "description": "A stored chat message.",
        "required": [
          "id",
          "chat_id",
          "role",
          "content",
          "created_at_ms"
        ],
        "properties": {
          "chat_id": {
            "type": "string",
            "format": "uuid",
            "description": "Chat it belongs to."
          },
          "content": {
            "type": "string",
            "description": "Text."
          },
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Message id."
          },
          "role": {
            "type": "string",
            "description": "`user` / `assistant` / `system` / `tool`."
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Run that produced / carried it."
          }
        }
      },
      "Mode": {
        "type": "string",
        "description": "What to do when the chat already has a running turn.",
        "enum": [
          "steer",
          "queue"
        ]
      },
      "RevokeGrant": {
        "type": "object",
        "description": "`DELETE /v1/bots/{id}/grants`.",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "$ref": "#/components/schemas/GrantTargetDto",
            "description": "The rule to remove."
          }
        }
      },
      "RunDto": {
        "type": "object",
        "description": "A run.",
        "required": [
          "id",
          "bot_id",
          "kind",
          "state",
          "created_at_ms",
          "updated_at_ms"
        ],
        "properties": {
          "bot_id": {
            "type": "string",
            "format": "uuid",
            "description": "Bot executing it."
          },
          "chat_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Chat, if any."
          },
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Failure message."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Run id."
          },
          "kind": {
            "type": "string",
            "description": "`turn`, `turn:routine`, ..."
          },
          "state": {
            "type": "string",
            "description": "`pending` / `running` / `waiting_approval` / `paused` / `succeeded` / `failed` / `cancelled`."
          },
          "updated_at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Last state change."
          }
        }
      },
      "Scope": {
        "type": "string",
        "description": "How far an approval reaches.",
        "enum": [
          "once",
          "this_chat",
          "always",
          "always_category"
        ]
      },
      "SendMessage": {
        "type": "object",
        "description": "`POST /v1/chats/{id}/messages`.",
        "required": [
          "text"
        ],
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "description": "Behaviour while a turn is running."
          },
          "text": {
            "type": "string",
            "description": "Message text."
          }
        }
      },
      "SendResponse": {
        "type": "object",
        "description": "Response of a sent message.",
        "required": [
          "delivery"
        ],
        "properties": {
          "delivery": {
            "$ref": "#/components/schemas/DeliveryKind",
            "description": "How it was delivered."
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The run to follow (`null` when queued: the turn has no run yet)."
          }
        }
      },
      "UsageSummary": {
        "type": "object",
        "description": "`GET /v1/usage`.",
        "required": [
          "runs",
          "total",
          "by_bot"
        ],
        "properties": {
          "by_bot": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BotUsage"
            },
            "description": "Per bot."
          },
          "runs": {
            "type": "integer",
            "format": "int64",
            "description": "Runs counted.",
            "minimum": 0
          },
          "total": {
            "$ref": "#/components/schemas/UsageTotals",
            "description": "Totals over all counted runs."
          }
        }
      },
      "UsageTotals": {
        "type": "object",
        "description": "Token totals.",
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "cached_tokens",
          "model_calls"
        ],
        "properties": {
          "cached_tokens": {
            "type": "integer",
            "format": "int64",
            "description": "Cached prompt tokens (subset of `prompt_tokens`).",
            "minimum": 0
          },
          "completion_tokens": {
            "type": "integer",
            "format": "int64",
            "description": "Completion tokens.",
            "minimum": 0
          },
          "model_calls": {
            "type": "integer",
            "format": "int64",
            "description": "Number of model calls.",
            "minimum": 0
          },
          "prompt_tokens": {
            "type": "integer",
            "format": "int64",
            "description": "Prompt tokens.",
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-install token stored in `<data dir>/api-token`."
      }
    }
  },
  "tags": [
    {
      "name": "meta"
    },
    {
      "name": "bots"
    },
    {
      "name": "chats"
    },
    {
      "name": "approvals"
    },
    {
      "name": "runs"
    },
    {
      "name": "usage"
    },
    {
      "name": "events"
